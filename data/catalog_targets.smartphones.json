  "schemaVersion": 1,
  "market": "IT",
  "category": "smartphone",
  "goal": {
    "targetFamilies": 32,
    "principle": "Prioritize useful market coverage and multi-store price comparison over raw product count.",
    "readiness": {
      "p0MinimumVerifiedStores": 3,
      "p1MinimumVerifiedStores": 2
    },
    "betaDepth": {
      "principle": "Deep comparison on the families most useful to beta users. Core families require 4 verified non-conditional stores; important families require 3. Breadth families remain discoverable but do not block beta depth readiness.",
      "coreFamilies": 12,
      "importantFamilies": 8,
      "coreMinimumVerifiedStores": 4,
      "importantMinimumVerifiedStores": 3
    },
    "variantDepth": {
      "principle": "A price comparison is complete only when DaniSua covers every commercial configuration that materially changes price, compatibility or utility. Required configurations may combine storage, RAM, condition and connectivity. Color and bundles remain opportunistic unless they define a distinct commercial configuration.",
      "initialFamilies": 4,
      "requiredWhenPriceShaping": [
        "storage",
        "ram",
        "condition",
        "connectivity"
      ],
      "opportunisticDimensions": [
        "color",
        "bundle"
      ],
      "trackedFamilies": 21,
      "marketCoverage": {
        "principle": "Market coverage is complete when every tracked configuration has either a verified current offer (standard or conditional) or verified market-state evidence explaining why no normal comparable offer is currently available.",
        "requireAllTrackedConfigurationsKnown": true
      }
    }
  },
